{
    name: ["ngal引擎剧情脚本高亮v1.1", ".ng"],
    colors: [
        "注释灰",#555555,#555555,
        "角色紫",#c277d8,#c277d8,
        "分隔符青",#5fc8d8,#5fc8d8,
        "指令蓝",#4298e8,#4298e8,
        "标签红",#e85555,#e85555,
        "变量橙",#f5a623,#f5a623,
        "数字色",#b5cea8,#b5cea8,
        "文件绿",#63c76a,#63c76a,
        "换行灰",#777777,#777777,
        "背景深灰",#252525,#252525,
        "对话正文",#dcdcdc,#dcdcdc,
        "赋值值",#9cdcfe,#9cdcfe
    ],
    comment:{
        startsWith: "//"
    },
    lineBackground: {match: /^[\s]*$/, color: "背景深灰"},
    contains:[
        {
            match:/#.*/,
            0:"注释灰"
        },
        {
            match:keywordsToRegex("music bg img load choose end input if"),
            0:"指令蓝"
        },
        {
            match:/\[.*?\]/,
            0:"标签红"
        },
        {
            match:/\{.*?\}/,
            0:"变量橙"
        },
        {
            match:/(\w+)\s*=\s*(.*?)(?=(?:\s*#|$))/,
            0:"变量橙",
            1:"分隔符青",
            2:"赋值值"
        },
        {
            match:/-?\d+(?:\.\d+)?%?/,
            0:"数字色"
        },
        {
            match:/\w+\.\w+/,
            0:"文件绿"
        },
        {
            match:/\w*[\u4e00-\u9fa5]+(?=:)/,
            0:"角色紫"
        },
        {
            match:/:/,
            0:"分隔符青"
        },
        {
            match:/\|/,
            0:"分隔符青"
        },
        {
            match:/:(.*)/,
            1:"对话正文"
        },
        {
            match:/\n/,
            0:"换行灰"
        }
    ]
}
